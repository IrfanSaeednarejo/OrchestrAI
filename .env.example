# ==========================================
# OrchestrAI Environment Configuration Example
# ==========================================

# Application Port
PORT=4000
APP_PORT=4000
NODE_ENV=development

# Database Connection (Neon)
DATABASE_URL=postgresql://user:password@endpoint.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@endpoint.neon.tech/neondb?sslmode=require

# Remote Redis Connection (Upstash rediss:// URL or standard redis://)
REDIS_URL=rediss://default:your_redis_token_here@your_redis_host:6379

# LLM & Third-Party APIs
GEMINI_API_KEY=your_gemini_api_key_here
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=OrchestrAI Support <onboarding@resend.dev>

# Client origin for CORS
CLIENT_ORIGIN=http://localhost:3000
