{
  "name": "orchestrai",
  "version": "1.0.0",
  "description": "A production-inspired stateful multi-agent orchestration platform for autonomous customer support, built with LangGraph and TypeScript.",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint src",
    "format": "prettier --write src",
    "dev": "tsx src/index.ts",
    "smoke-test": "tsx src/shared/smoke-test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/persistence/db/migrate.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.5.1",
    "@types/pg": "^8.23.1",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@langchain/core": "^1.2.11",
    "@langchain/langgraph": "^1.4.15",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.23.0",
    "redis": "^6.2.1",
    "zod": "^4.6.4"
  }
}
