POSTGRES_USER=orchestrai
POSTGRES_PASSWORD=changeme_local_dev_password
POSTGRES_DB=orchestrai
POSTGRES_PORT=5432

REDIS_PORT=6379

# Required for Phase 5 ingestion/retrieval
GEMINI_API_KEY=your_key_here

# Optional: LLM model override (default: gemini-3.5-flash-lite)
# GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: price per million tokens — unset by default; used only by scripts/report-metrics.ts
# GEMINI_INPUT_PRICE_PER_MTOK=0.075
# GEMINI_OUTPUT_PRICE_PER_MTOK=0.30

# Resend Email Service
RESEND_API_KEY=re_your_api_key_here
# EMAIL_FROM=OrchestrAI Support <onboarding@resend.dev>
# EMAIL_DRY_RUN=false

# Optional, defaults shown
# NODE_ENV=development
# APP_PORT=4000
# POSTGRES_HOST=localhost
# REDIS_HOST=localhost

# Phase 17: Frontend origin for CORS (lock to your Next.js dev URL in production)
# CLIENT_ORIGIN=http://localhost:3000

# Phase 17: Dev-only demo & verification endpoints (never true in production)
# ENABLE_DEMO_ENDPOINTS=false
